<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: back up the app's data except the private note (private.xml) and the widget's cache with the device location (widget.xml). -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="private.xml" />
        <exclude domain="sharedpref" path="widget.xml" />
</full-backup-content>
