<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the private note (private.xml) is excluded from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="private.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="private.xml" />
    </device-transfer>
</data-extraction-rules>
